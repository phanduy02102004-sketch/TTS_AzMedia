# Copy this file to .env on the server and replace every placeholder.
APP_NAME="AZ Media ATS"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-domain.example

APP_IMAGE=ghcr.io/your-org/your-repository:latest
NGINX_IMAGE=ghcr.io/your-org/your-repository-nginx:latest

# Bind to localhost when using a host-level TLS reverse proxy.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

DB_DATABASE=azmedia
DB_USERNAME=azmedia
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_SECURE_COOKIE=true
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="AZ Media ATS"
